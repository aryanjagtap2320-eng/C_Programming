#include<stdio.h>
#include<stdlib.h>

int Display(int iNO)
{
    if (iNO < 0)
    {
        iNO = -iNO;
    }
    
    if (iNO < 10)
    {
        printf("Hello\n");
    }
    else
    {
        printf("Demo\n");
    }
}
int main()
{
    int iValue = 0;
    printf("Enter the number : \n");
    scanf("%d",&iValue);

    Display(iValue);


    return EXIT_SUCCESS;
}